# Authentik Configuration
AUTHENTIK_HOST=auth.artisan-tools.com
AUTHENTIK_SECRET_KEY=<generate-with-openssl-rand-base64-32>

# Application Ports (dev only — prod uses 80/443 directly)
APP_PORT_HTTP=80
APP_PORT_HTTPS=443

# PostgreSQL Database
POSTGRES_HOST=postgres
POSTGRES_USER=authentik
POSTGRES_PASSWORD=<generate-with-openssl-rand-base64-24>
POSTGRES_DB=authentik

# SMTP Configuration (Development - Mailpit)
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=false
SMTP_USE_SSL=false
SMTP_FROM=noreply@auth.artisan-tools.com

# SMTP Configuration (Production - Postfix on artisan-hq-network-01)
# Local trusted relay only — no auth/TLS needed
# SMTP_HOST=postfix
# SMTP_PORT=25
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_USE_TLS=false
# SMTP_USE_SSL=false
# SMTP_FROM=noreply@auth.artisan-tools.com

# Production Notes:
# - TLS is handled by Traefik (no cert config needed here)
# - Uncomment the production SMTP section above for prod
