# Authentik Configuration
AUTHENTIK_HOST=auth.artisan-tools.com
AUTHENTIK_SECRET_KEY=<generate-with-openssl-rand-base64-32>

# Authentik version tag — shared by core, worker, and the LDAP outpost so
# they can never skew. REQUIRED (no default): compose refuses to run any
# command until this is set. Upgrades MUST step ONE release at a time
# (e.g. 2025.10 -> 2025.12 -> 2026.2 -> 2026.5): bump this one hop at a
# time and verify health between hops. See "Upgrading Authentik" in README.
AUTHENTIK_TAG=2026.5
# Registry override (default: ghcr.io/goauthentik/server)
# AUTHENTIK_IMAGE=ghcr.io/goauthentik/server
# Since 2026.5 authentik listens on [::] (dual-stack) by default. If the
# host has IPv6 disabled and core becomes unreachable after that hop, add
# AUTHENTIK_LISTEN__HTTP: 0.0.0.0:9000 to the core service environment.

# LDAP outpost API token (prod). Create the LDAP provider + outpost in the
# Authentik admin UI, then copy the outpost's token here BEFORE starting
# the ldap service. Empty token => ldap container logs 403 auth errors.
AUTHENTIK_LDAP_TOKEN=

# Application Ports (dev only — prod uses 80/443 directly)
APP_PORT_HTTP=80
APP_PORT_HTTPS=443

# PostgreSQL Database
POSTGRES_HOST=postgres
POSTGRES_USER=authentik
POSTGRES_PASSWORD=<generate-with-openssl-rand-base64-24>
POSTGRES_DB=authentik

# SMTP Configuration (Development - Mailpit)
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=false
SMTP_USE_SSL=false
SMTP_FROM=noreply@auth.artisan-tools.com

# SMTP Configuration (Production - Postfix on artisan-hq-network-01)
# Local trusted relay only — no auth/TLS needed
# SMTP_HOST=postfix
# SMTP_PORT=25
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_USE_TLS=false
# SMTP_USE_SSL=false
# SMTP_FROM=noreply@auth.artisan-tools.com

# Production Notes:
# - TLS is handled by Traefik (no cert config needed here)
# - Uncomment the production SMTP section above for prod
