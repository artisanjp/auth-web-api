#!/bin/bash

# Docker Compose Service Management Script
# Usage: scripts/up <environment> <service1> [service2] [service3] ...
#
# Environments: dev, prod
# Services: auth, db, mail, all (or direct names: core, postgres, worker, nginx, mailpit, ldap)
#
# Examples:
#   scripts/up dev all         => Start all services in dev
#   scripts/up prod all        => Start all services in prod
#   scripts/up dev auth        => Start only core service in dev
#   scripts/up dev db auth     => Start postgres and core services in dev

set -e

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

print_info() { echo -e "${BLUE}[info]${NC} $1"; }
print_success() { echo -e "${GREEN}[ok]${NC} $1"; }
print_warning() { echo -e "${YELLOW}[warn]${NC} $1" >&2; }
print_error() { echo -e "${RED}[error]${NC} $1" >&2; }

show_usage() {
    echo "Usage: $0 <environment> <service1> [service2] [service3] ..."
    echo ""
    echo "Environments:"
    echo "  dev   - Development environment"
    echo "  prod  - Production environment"
    echo ""
    echo "Services:"
    echo "  auth  - Authentik server (maps to 'core')"
    echo "  db    - PostgreSQL database (maps to 'postgres', dev only)"
    echo "  mail  - Mailpit email testing (maps to 'mailpit', dev only)"
    echo "  all   - All services (env-dependent)"
    echo "  core, worker, postgres, nginx, mailpit, ldap - Direct service names"
    echo ""
    echo "Examples:"
    echo "  $0 dev all         # Start all dev services"
    echo "  $0 prod all        # Start all prod services"
    echo "  $0 dev auth        # Start only core service in dev"
    echo "  $0 dev db auth     # Start postgres and core in dev"
}

validate_environment() {
    local env=$1
    if [[ "$env" != "dev" && "$env" != "prod" ]]; then
        print_error "Invalid environment: $env"
        print_info "Valid environments: dev, prod"
        exit 1
    fi
}

map_services() {
    local environment=$1
    shift
    local services=()

    for service in "$@"; do
        case "$service" in
            "auth")
                services+=("core")
                ;;
            "db")
                if [ "$environment" == "prod" ]; then
                    print_error "'db' alias is dev-only (no postgres in prod)"
                    exit 1
                fi
                services+=("postgres")
                ;;
            "mail")
                if [ "$environment" == "prod" ]; then
                    print_error "'mail' alias is dev-only (no mailpit in prod)"
                    exit 1
                fi
                services+=("mailpit")
                ;;
            "all")
                if [ "$environment" == "prod" ]; then
                    services+=("core" "worker" "ldap")
                else
                    services+=("postgres" "core" "worker" "nginx" "mailpit")
                fi
                ;;
            "core"|"worker"|"postgres"|"nginx"|"mailpit"|"ldap")
                services+=("$service")
                ;;
            *)
                print_warning "Unknown service: $service (will pass through as-is)"
                services+=("$service")
                ;;
        esac
    done

    if [ ${#services[@]} -gt 0 ]; then
        printf '%s\n' "${services[@]}" | awk '!seen[$0]++'
    fi
}

main() {
    if [ $# -lt 2 ]; then
        print_error "Insufficient arguments provided"
        echo ""
        show_usage
        exit 1
    fi

    local environment=$1
    shift
    local service_args=("$@")

    validate_environment "$environment"

    local mapped_services
    mapfile -t mapped_services < <(map_services "$environment" "${service_args[@]}")

    if [ ${#mapped_services[@]} -eq 0 ]; then
        print_error "No valid services specified"
        echo ""
        show_usage
        exit 1
    fi

    local compose_file="docker-compose.${environment}.yml"

    if [ ! -f "$compose_file" ]; then
        print_error "Compose file not found: $compose_file"
        exit 1
    fi

    print_info "Environment: $environment"
    print_info "Services: ${mapped_services[*]}"
    print_info "Command: docker compose -f $compose_file up -d ${mapped_services[*]}"
    echo ""

    print_info "Starting services..."
    if docker compose -f "$compose_file" up -d "${mapped_services[@]}"; then
        print_success "Services started successfully!"
        echo ""
        print_info "Running containers:"
        docker compose -f "$compose_file" ps
        echo ""

        print_info "Showing logs for started services..."
        print_info "Command: scripts/logs $environment ${service_args[*]} --follow"
        echo ""
        scripts/logs "$environment" "${service_args[@]}" --follow
    else
        print_error "Failed to start services"
        exit 1
    fi
}

main "$@"
