#!/bin/bash

# Docker Compose Service Management Script - DOWN
# Usage: scripts/down <environment> <service1> [service2] [service3] ...
#
# Environments: dev, prod
# Services: auth, db, mail, all (or direct names: core, postgres, worker, nginx, mailpit, ldap)
#
# Examples:
#   scripts/down dev all           => Stop all services in dev
#   scripts/down prod all          => Stop all services in prod
#   scripts/down dev auth          => Stop only core service in dev
#   scripts/down dev all --volumes => Stop all and remove volumes

set -e

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

print_info() { echo -e "${BLUE}[info]${NC} $1"; }
print_success() { echo -e "${GREEN}[ok]${NC} $1"; }
print_warning() { echo -e "${YELLOW}[warn]${NC} $1" >&2; }
print_error() { echo -e "${RED}[error]${NC} $1" >&2; }

show_usage() {
    echo "Usage: $0 <environment> <service1> [service2] [service3] ..."
    echo ""
    echo "Environments:"
    echo "  dev   - Development environment"
    echo "  prod  - Production environment"
    echo ""
    echo "Services:"
    echo "  auth  - Authentik server (maps to 'core')"
    echo "  db    - PostgreSQL database (maps to 'postgres', dev only)"
    echo "  mail  - Mailpit email testing (maps to 'mailpit', dev only)"
    echo "  all   - All services (env-dependent)"
    echo "  core, worker, postgres, nginx, mailpit, ldap - Direct service names"
    echo ""
    echo "Options:"
    echo "  --volumes, -v      # Remove volumes as well"
    echo "  --remove-orphans   # Remove orphaned containers"
    echo ""
    echo "Examples:"
    echo "  $0 dev all           # Stop all dev services"
    echo "  $0 prod all          # Stop all prod services"
    echo "  $0 dev auth          # Stop only core service in dev"
    echo "  $0 dev all --volumes # Stop all and remove volumes"
}

validate_environment() {
    local env=$1
    if [[ "$env" != "dev" && "$env" != "prod" ]]; then
        print_error "Invalid environment: $env"
        print_info "Valid environments: dev, prod"
        exit 1
    fi
}

map_services() {
    local environment=$1
    shift
    local services=()

    for service in "$@"; do
        case "$service" in
            "auth")
                services+=("core")
                ;;
            "db")
                if [ "$environment" == "prod" ]; then
                    print_error "'db' alias is dev-only (no postgres in prod)"
                    exit 1
                fi
                services+=("postgres")
                ;;
            "mail")
                if [ "$environment" == "prod" ]; then
                    print_error "'mail' alias is dev-only (no mailpit in prod)"
                    exit 1
                fi
                services+=("mailpit")
                ;;
            "all")
                if [ "$environment" == "prod" ]; then
                    services+=("core" "worker" "ldap")
                else
                    services+=("postgres" "core" "worker" "nginx" "mailpit")
                fi
                ;;
            "core"|"worker"|"postgres"|"nginx"|"mailpit"|"ldap")
                services+=("$service")
                ;;
            *)
                print_warning "Unknown service: $service (will pass through as-is)"
                services+=("$service")
                ;;
        esac
    done

    if [ ${#services[@]} -gt 0 ]; then
        printf '%s\n' "${services[@]}" | awk '!seen[$0]++'
    fi
}

parse_flags() {
    local flags=()
    for arg in "$@"; do
        case "$arg" in
            "--volumes"|"-v")
                flags+=("--volumes")
                ;;
            "--remove-orphans")
                flags+=("--remove-orphans")
                ;;
        esac
    done
    if [ ${#flags[@]} -gt 0 ]; then
        printf '%s\n' "${flags[@]}"
    fi
}

main() {
    if [ $# -lt 2 ]; then
        print_error "Insufficient arguments provided"
        echo ""
        show_usage
        exit 1
    fi

    local environment=$1
    shift
    local all_args=("$@")

    validate_environment "$environment"

    local flags=()
    mapfile -t flags < <(parse_flags "${all_args[@]}")

    local service_args=()
    for arg in "${all_args[@]}"; do
        if [[ "$arg" != "--volumes" && "$arg" != "-v" && "$arg" != "--remove-orphans" ]]; then
            service_args+=("$arg")
        fi
    done

    if [ ${#service_args[@]} -eq 0 ]; then
        print_error "No services specified (only flags provided)"
        echo ""
        show_usage
        exit 1
    fi

    local mapped_services
    mapfile -t mapped_services < <(map_services "$environment" "${service_args[@]}")

    if [ ${#mapped_services[@]} -eq 0 ]; then
        print_error "No valid services specified"
        echo ""
        show_usage
        exit 1
    fi

    local compose_file="docker-compose.${environment}.yml"

    if [ ! -f "$compose_file" ]; then
        print_error "Compose file not found: $compose_file"
        exit 1
    fi

    local cmd=(docker compose -f "$compose_file" down "${flags[@]}" "${mapped_services[@]}")

    print_info "Environment: $environment"
    print_info "Services: ${mapped_services[*]}"
    if [ ${#flags[@]} -gt 0 ]; then
        print_info "Flags: ${flags[*]}"
    fi
    print_info "Command: ${cmd[*]}"
    echo ""

    print_info "Stopping services..."
    if "${cmd[@]}"; then
        print_success "Services stopped successfully!"
        echo ""
        print_info "Remaining containers:"
        docker compose -f "$compose_file" ps --all 2>/dev/null || print_info "No containers running"
    else
        print_error "Failed to stop services"
        exit 1
    fi
}

main "$@"
