#!/bin/bash

# Docker Compose Service Management Script - RESET
# Usage: scripts/reset <environment> <volume|all>
#
# Environments: dev, prod
# Volumes: postgres, media, templates, all
#
# Examples:
#   scripts/reset dev postgres     => Remove postgres volume (dev only)
#   scripts/reset dev all          => Remove all dev volumes
#   scripts/reset prod all         => Remove all prod volumes

set -e

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

print_info() { echo -e "${BLUE}[info]${NC} $1"; }
print_success() { echo -e "${GREEN}[ok]${NC} $1"; }
print_warning() { echo -e "${YELLOW}[warn]${NC} $1"; }
print_error() { echo -e "${RED}[error]${NC} $1"; }

show_usage() {
    echo "Usage: $0 <environment> <volume|all>"
    echo ""
    echo "Environments:"
    echo "  dev   - Development environment"
    echo "  prod  - Production environment"
    echo ""
    echo "Dev Volumes:"
    echo "  postgres   - PostgreSQL data"
    echo "  media      - Authentik media files"
    echo "  templates  - Authentik templates"
    echo "  all        - All dev volumes"
    echo ""
    echo "Prod Volumes:"
    echo "  media      - Authentik media files"
    echo "  templates  - Authentik templates"
    echo "  all        - All prod volumes"
    echo ""
    echo "Examples:"
    echo "  $0 dev postgres     # Remove postgres volume (dev only)"
    echo "  $0 dev media        # Remove media volume"
    echo "  $0 dev all          # Remove all dev volumes"
    echo "  $0 prod all         # Remove all prod volumes"
}

validate_environment() {
    local env=$1
    if [[ "$env" != "dev" && "$env" != "prod" ]]; then
        print_error "Invalid environment: $env"
        print_info "Valid environments: dev, prod"
        exit 1
    fi
}

main() {
    if [ $# -lt 2 ]; then
        print_error "Insufficient arguments provided"
        echo ""
        show_usage
        exit 1
    fi

    local environment=$1
    local service=$2

    validate_environment "$environment"

    local compose_file="docker-compose.${environment}.yml"

    if [ ! -f "$compose_file" ]; then
        print_error "Compose file not found: $compose_file"
        exit 1
    fi

    if [ "$service" == "all" ]; then
        print_warning "This will remove ALL Docker volumes ($environment mode)"
        print_warning "This action cannot be undone!"
        read -p "Are you sure you want to continue? (yes/no): " CONFIRM

        CONFIRM_LOWER=$(echo "$CONFIRM" | tr '[:upper:]' '[:lower:]')
        if [ "$CONFIRM_LOWER" != "yes" ] && [ "$CONFIRM_LOWER" != "y" ]; then
            print_info "Operation cancelled"
            exit 0
        fi

        print_info "Stopping all containers..."
        docker compose -f "$compose_file" down

        print_info "Removing volumes..."
        docker compose -f "$compose_file" down -v

        print_success "All volumes removed successfully"
    else
        local VOLUME_NAME=""

        case "$service" in
            postgres)
                if [ "$environment" == "prod" ]; then
                    print_error "postgres volume is external in production"
                    exit 1
                fi
                VOLUME_NAME="auth-web-api_artisan-auth-postgres-data"
                ;;
            media)
                VOLUME_NAME="auth-web-api_artisan-auth-media"
                ;;
            templates)
                VOLUME_NAME="auth-web-api_artisan-auth-templates"
                ;;
            *)
                if [ "$environment" == "prod" ]; then
                    print_error "Unknown volume '$service'"
                    print_info "Available volumes: media, templates, all"
                else
                    print_error "Unknown volume '$service'"
                    print_info "Available volumes: postgres, media, templates, all"
                fi
                exit 1
                ;;
        esac

        print_warning "This will remove the '$VOLUME_NAME' volume"
        print_warning "All data in this volume will be lost!"
        read -p "Are you sure you want to continue? (yes/no): " CONFIRM

        CONFIRM_LOWER=$(echo "$CONFIRM" | tr '[:upper:]' '[:lower:]')
        if [ "$CONFIRM_LOWER" != "yes" ] && [ "$CONFIRM_LOWER" != "y" ]; then
            print_info "Operation cancelled"
            exit 0
        fi

        case "$service" in
            postgres)
                print_info "Stopping postgres container..."
                docker compose -f "$compose_file" stop postgres 2>/dev/null || true
                docker compose -f "$compose_file" rm -f postgres 2>/dev/null || true
                ;;
            media|templates)
                print_info "Stopping core and worker containers..."
                docker compose -f "$compose_file" stop core worker 2>/dev/null || true
                docker compose -f "$compose_file" rm -f core worker 2>/dev/null || true
                ;;
        esac

        print_info "Removing volume..."
        docker volume rm "${VOLUME_NAME}" 2>/dev/null || echo "Volume already removed or doesn't exist"

        print_success "Volume removed successfully"
    fi
}

main "$@"
