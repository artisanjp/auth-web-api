#!/bin/bash

set -e

# Configuration
DOMAIN="${1:-auth.artisan-tools.com}"
CERT_DIR="$(dirname "$0")/../certs"
DAYS_VALID=365

# Colors for output
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

echo -e "${YELLOW}=== Self-Signed Certificate Generator ===${NC}"
echo ""
echo "Domain: ${DOMAIN}"
echo "Certificate Directory: ${CERT_DIR}"
echo "Valid for: ${DAYS_VALID} days"
echo ""

# Create certs directory if it doesn't exist
mkdir -p "${CERT_DIR}"

# Check if certificates already exist
if [ -f "${CERT_DIR}/server.crt" ] || [ -f "${CERT_DIR}/server.key" ]; then
    echo -e "${YELLOW}Warning: Certificate files already exist!${NC}"
    read -p "Overwrite existing certificates? (y/N): " -n 1 -r
    echo ""
    if [[ ! $REPLY =~ ^[Yy]$ ]]; then
        echo "Aborted."
        exit 0
    fi
fi

# Generate private key
echo -e "${GREEN}Generating private key...${NC}"
openssl genrsa -out "${CERT_DIR}/server.key" 2048

# Generate certificate signing request (CSR)
echo -e "${GREEN}Generating certificate signing request...${NC}"
openssl req -new -key "${CERT_DIR}/server.key" \
    -out "${CERT_DIR}/server.csr" \
    -subj "/C=JP/ST=Tokyo/L=Tokyo/O=Artisan/OU=Development/CN=${DOMAIN}"

# Generate self-signed certificate
echo -e "${GREEN}Generating self-signed certificate...${NC}"
openssl x509 -req -days ${DAYS_VALID} \
    -in "${CERT_DIR}/server.csr" \
    -signkey "${CERT_DIR}/server.key" \
    -out "${CERT_DIR}/server.crt" \
    -extfile <(printf "subjectAltName=DNS:${DOMAIN},DNS:*.${DOMAIN},DNS:localhost,IP:127.0.0.1")

# Clean up CSR file
rm -f "${CERT_DIR}/server.csr"

# Set proper permissions
chmod 600 "${CERT_DIR}/server.key"
chmod 644 "${CERT_DIR}/server.crt"

echo ""
echo -e "${GREEN}=== Certificate Generated Successfully ===${NC}"
echo ""
echo "Certificate files created:"
echo "  - ${CERT_DIR}/server.crt"
echo "  - ${CERT_DIR}/server.key"
echo ""
echo "Certificate details:"
openssl x509 -in "${CERT_DIR}/server.crt" -noout -subject -dates
echo ""
echo -e "${YELLOW}Note: This is a self-signed certificate for development use only.${NC}"
echo -e "${YELLOW}Your browser will show a security warning. You'll need to accept it manually.${NC}"
